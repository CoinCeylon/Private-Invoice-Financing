# Copy to .env in the repository root:  cp .env.example .env
# .env is never committed. Never put real values in this example file, and never use a real
# (mainnet) wallet anywhere: the seed phrases below are for testnet demo wallets only.

# --- Database (Docker creates it on first start) ---
POSTGRES_USER=invoice_dev
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=invoice_financing

# Only for apps run directly on your machine, outside the dev container.
# Inside the dev container, DATABASE_URL is set by docker-compose.dev.yml.
# DATABASE_URL=postgresql://invoice_dev:change_me_locally@localhost:5432/invoice_financing

# --- Extraction service ---
# Only for the API run directly on your machine. Inside the dev container it is
# http://extraction:8000, set by docker-compose.dev.yml.
# EXTRACTION_URL=http://localhost:8000

# --- Chains (see docs/interfaces.md section 9) ---
# fake: the API uses FakeRegistry and FakeProver. real: P3's and P4's libraries.
CHAIN_MODE=fake

# --- Midnight ---
# From Midnight's compatibility matrix. P4 confirms before changing.
PROOF_SERVER_VERSION=9.0.2
# http://proof-server:6300 inside the dev container.
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
MIDNIGHT_INDEXER_URL=
MIDNIGHT_NODE_URL=
MIDNIGHT_CONTRACT_ADDRESS=
# Testnet wallet seed, in your local .env only. Never a real wallet.
MIDNIGHT_WALLET_SEED=

# --- Cardano ---
CARDANO_NETWORK=preprod
# Free key from your chain provider (e.g. Blockfrost). Each person uses their own.
BLOCKFROST_PROJECT_ID=
# Four preprod demo wallets, seed phrases in your local .env only. Never a real wallet.
CARDANO_SUPPLIER_MNEMONIC=
CARDANO_BUYER_MNEMONIC=
CARDANO_LENDER_A_MNEMONIC=
CARDANO_LENDER_B_MNEMONIC=

# Tool versions (pnpm, Aiken, Compact, Python) are pinned in
# .devcontainer/Dockerfile, not here, so everyone gets the same ones.