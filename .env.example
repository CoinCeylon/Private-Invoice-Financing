# Copy this file to .env in the repository root.
# Example database names; set your own local password before starting.
POSTGRES_USER=invoice_dev
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=invoice_financing

# Required: set the exact proof-server image tag selected by P4.
# It must match P4's Compact/Midnight.js toolchain. No latest default is used.
PROOF_SERVER_VERSION=P4
